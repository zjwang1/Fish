# ── Bit.com (Matrixport) Stock API credentials ──────────────────────
BITCOM_ACCESS_KEY=your_bitcom_access_key_here
BITCOM_SECRET_KEY=your_bitcom_secret_key_here
# BITCOM_BASE_URL=https://mapi.matrixport.com

# ── Binance API credentials ─────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Optional: use testnet for paper trading
BINANCE_TESTNET=true

# Minimum annualised funding-rate yield (%) to consider entry
MIN_FUNDING_APY=10.0

# Maximum acceptable basis divergence (%) for entry
MAX_BASIS_PCT=1.0

# Default number of shares per trade
DEFAULT_TRADE_QTY=10

# Polling interval in seconds
POLL_INTERVAL=10

# ── Maker-first execution ────────────────────────────────────────────
# Binance maker fee = 0%, so we always place limit orders there first.
# After Binance fill, we taker on Bit.com (~0.01% fee).
# Timeout (seconds) before cancelling an unfilled Binance maker order
MAKER_ORDER_TIMEOUT=60
# How often (seconds) to poll Binance for fill status
MAKER_POLL_INTERVAL=0.5
# Max retries for the stock (Bit.com) leg after Binance fills.
# Critical for zero-exposure: we MUST hedge the Binance fill on the stock side.
MAX_STOCK_RETRIES=5
# Maximum total position notional value (USD) across all pairs.
# Prevents over-leveraging that could lead to futures liquidation.
# Set to 0 to disable the limit (default).
# MAX_POSITION_VALUE_USD=50000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
