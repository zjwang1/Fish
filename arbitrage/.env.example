# ── Bit.com (Matrixport) Stock API credentials ──────────────────────
BITCOM_ACCESS_KEY=your_bitcom_access_key_here
BITCOM_SECRET_KEY=your_bitcom_secret_key_here
# BITCOM_BASE_URL=https://mapi.matrixport.com

# ── Binance API credentials ─────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Optional: use testnet for paper trading
BINANCE_TESTNET=true

# Minimum annualised funding-rate yield (%) to consider entry
MIN_FUNDING_APY=10.0

# Maximum acceptable basis divergence (%) for entry
MAX_BASIS_PCT=1.0

# Default number of shares per trade
DEFAULT_TRADE_QTY=10

# Polling interval in seconds
POLL_INTERVAL=10

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
